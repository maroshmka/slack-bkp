# Slack bot token with scopes: channels:history, channels:read, channels:join, users:read, files:read
SLACK_BOT_TOKEN=xoxb-...

# GCS bucket to store transcripts, uploaded files/images, and sync state
GCS_BUCKET=my-slack-backup-bucket

# Optional: prefix path inside the bucket (default: slack-backup)
GCS_PREFIX=slack-backup

# Optional: local directory for sync-state + lock file (default: ./state)
STATE_DIR=./state
